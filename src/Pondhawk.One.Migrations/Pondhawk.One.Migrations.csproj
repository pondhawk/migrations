<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Pondhawk.Migrations</RootNamespace>
        <ApplicationIcon>smithy.ico</ApplicationIcon>
        <Company>Pond Hawk Technologies Inc.</Company>
        <DebugType>embedded</DebugType>

        <!-- dotnet tool packaging -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>pondhawk-migrations</ToolCommandName>
        <PackageId>Pondhawk.Migrations</PackageId>
        <Version>1.0.0</Version> <!-- default; overridden by Cake build -->
        <Authors>Pond Hawk Technologies Inc.</Authors>
        <Description>Database schema migration CLI tool with multi-phase script execution</Description>
        <PackageProjectUrl>https://github.com/pondhawk/migrations</PackageProjectUrl>
        <RepositoryUrl>https://github.com/pondhawk/migrations.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright (c) 2025 Pond Hawk Technologies Inc.</Copyright>
        <PackageIcon>pht-small-logo.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
      <None Include="..\..\pht-small-logo.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\dbup-core\dbup-core.csproj" />
      <ProjectReference Include="..\dbup-mysql\dbup-mysql.csproj" />
      <ProjectReference Include="..\dbup-postgresql\dbup-postgresql.csproj" />
      <ProjectReference Include="..\dbup-sqlite\dbup-sqlite.csproj" />
      <ProjectReference Include="..\dbup-sqlserver\dbup-sqlserver.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="AWSSDK.RDS" Version="4.0.9.1" />
      <PackageReference Include="JetBrains.Annotations" Version="2025.2.2" />
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.9" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.9" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
      <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
      <PackageReference Include="Pondhawk.Rules" Version="1.0.24" />
      <PackageReference Include="Pondhawk.Watch" Version="1.0.24" />
      <PackageReference Include="Serilog" Version="4.3.0" />
      <PackageReference Include="Spectre.Console.Cli" Version="0.51.1" />
    </ItemGroup>

</Project>
